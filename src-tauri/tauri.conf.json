{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Math.mumu",
  "version": "1.0.0",
  "identifier": "com.notepadcalc.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "计算稿纸",
        "width": 600,
        "height": 600,
        "minWidth": 600,
        "minHeight": 600,
        "decorations": false,
        "shadow": false,
        "visible": true,
        "backgroundColor": "#1a1917",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
